{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safe Build Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "input",
          "expected",
          "deterministic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "functional",
              "negative",
              "security"
            ]
          },
          "input": {},
          "expected": {},
          "deterministic": {
            "const": true
          }
        }
      }
    }
  }
}
