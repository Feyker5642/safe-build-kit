{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safe Build Artifact Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "required"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "description",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "git_diff",
              "changed_files",
              "test_results",
              "build_results",
              "known_limitations",
              "source_traceability",
              "isolation_evidence",
              "human_acceptance"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
