{
  "name": "safe-build-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A portable build-contract compiler and verification kit for AI coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Feyker5642/safe-build-kit.git"
  },
  "homepage": "https://github.com/Feyker5642/safe-build-kit#readme",
  "bugs": {
    "url": "https://github.com/Feyker5642/safe-build-kit/issues"
  },
  "type": "module",
  "bin": {
    "safe-build": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schemas.mjs",
    "build:action": "npm run build && node scripts/build-action.mjs",
    "test": "npm run build:action && node --test tests/validate.test.mjs tests/verify.test.mjs tests/report.test.mjs tests/release.test.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.45.0",
    "typescript": "6.0.3"
  }
}
