{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safe Build Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "buildPackHash",
    "baseCommit",
    "headCommit",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "buildPackHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "headCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
